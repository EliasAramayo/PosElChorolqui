<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shared design system. Every color resolves through the active
       theme dictionary (LightTheme/DarkTheme) so both modes stay coherent. -->

  <!-- Cards and surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- Prominent total zone (point of sale ticket). -->
  <Style Selector="Border.totalZone">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!-- Connection pill shown in the topbar. -->
  <Style Selector="Border.statusPill">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.statusPillText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Typography scale: titles 22-24, key values 18-30, body 14-15, secondary 12-13. -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.cardText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.keyValue">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.totalAmount">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.emptyState">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.badgeText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.emptyGlyph">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.navGlyphText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Small rounded badge used for the provisional brand mark. -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
  </Style>

  <!-- Monogram badge per sidebar module; highlighted when selected. -->
  <Style Selector="Border.navGlyph">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
  </Style>

  <!-- Badge behind empty-state glyphs. -->
  <Style Selector="Border.emptyBadge">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
  </Style>

  <!-- Status dots for the real backend connection state. -->
  <Style Selector="Border.statusDot">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons: comfortable 40px hit targets with hover, pressed,
       keyboard-focus and disabled states. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,10" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed">
    <Setter Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
  </Style>
  <Style Selector="Button.primary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.primary:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
  </Style>
  <Style Selector="Button.secondary:pressed">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.secondary:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.secondary:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
  </Style>
  <Style Selector="Button.danger:pressed">
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Button.danger:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.danger:disabled">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- Sidebar navigation list (items are styled locally in MainWindow). -->
  <Style Selector="ListBox.sideNav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox.field">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <!-- Protagonist search (point of sale, catalogs): taller and larger. -->
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="46" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.field">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ToggleSwitch.field">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Table header row used by list screens (no data yet, header only). -->
  <Style Selector="Border.tableHeader">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="TextBlock.tableHeaderText">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tableHeaderRight">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <!-- Chart / summary placeholder zones. -->
  <Style Selector="Border.chartZone">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="24" />
    <Setter Property="MinHeight" Value="160" />
  </Style>
</Styles>
