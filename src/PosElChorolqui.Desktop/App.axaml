<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PosElChorolqui.Desktop.App"
             xmlns:local="using:PosElChorolqui.Desktop"
             RequestedThemeVariant="Light">

    <!-- The active theme dictionary (LightTheme/DarkTheme) is merged at startup
         by AppThemeService so light and dark never coexist with duplicate keys. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/DesignSystem.axaml" />
    </Application.Styles>
</Application>
